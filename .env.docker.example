# Copy to .env.docker (gitignored) for docker-compose. Fill every required
# value locally. Never commit the filled file, paste tokens into chat, or put
# them in URLs/config.js.
#
# Generate strong independent tokens without reusing examples:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The command prints the value to YOUR terminal; docs and reports here contain
# placeholders only.

# Only published host port. Nginx serves the UI and proxies /api.
PUBLIC_PORT=8080

# Required. Operator token for the admin page/API (Authorization: Bearer).
RVS_ADMIN_TOKEN=
# Required for a public/cloud session API (visitor token). Use a different value.
RVS_ACCESS_TOKEN=

# Optional chat model credential; missing means clear degraded startup, not a crash.
DEEPSEEK_API_KEY=

# Optional comma-separated explicit origins for a separately hosted frontend,
# e.g. https://support.example.com. Leave empty for same-origin nginx.
RVS_ALLOWED_ORIGINS=

RVS_INSTANCE_NAME=扫地机器人售后客服
